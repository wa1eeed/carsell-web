# ————— الأساس —————
DATABASE_URL="postgresql://user:pass@localhost:5432/carsell"
# قاعدة الظل — يحتاجها `prisma migrate dev` محليًا فقط، لا في الإنتاج
SHADOW_DATABASE_URL="postgresql://user:pass@localhost:5432/carsell_shadow"
# Redis — تخزين مؤقت وتحديد معدّل، و**Pub/Sub بين Next وخدمة realtime**
REDIS_URL="redis://localhost:6379"

# خدمة اللحظية — تطبيق Coolify ثانٍ، لا داخل Next
# (كل نشر لـNext يقطع الاتصالات الطويلة، وهذا عطب لا يُغتفر في مزاد)
WS_URL="wss://ws.carsell.one"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ————— المصادقة —————
JWT_SECRET=""            # 32 بايت عشوائي: openssl rand -base64 32
SECRETS_KEY=""           # 32 بايت عشوائي — يشفّر أسرار التكاملات: openssl rand -base64 32
OTP_PEPPER=""            # 32 بايت عشوائي

# ————— الوسائط (Cloudflare R2) —————
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="carsell-media"
R2_PUBLIC_URL=""

# ————— البريد والرسائل —————
RESEND_API_KEY=""
MAIL_FROM="CarSell <no-reply@carsell.one>"
SMS_PROVIDER_KEY=""
SMS_SENDER_ID="CarSell"

# ————— المدفوعات —————
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ————— المراقبة —————
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ————— التكاملات الحكومية والخدمات —————
VIN_LOOKUP_URL=""
VIN_LOOKUP_KEY=""
MOJAZ_API_URL=""
MOJAZ_API_KEY=""

# ————— مفاتيح الميزات —————
FEATURE_AI_PRICING="false"
FEATURE_NL_SEARCH="false"
# جلب بيانات المركبة من الرقم التسلسلي — يحتاج ربطًا بخدمة «يقين»، مؤجَّل.
# مطفأة: يختفي الحقل كلّيًا والنموذج يعمل كاملًا بدونه.
FEATURE_VIN_LOOKUP="false"
FEATURE_ADS="true"

# APP_ENV — بيئة التشغيل الصريحة، منفصلة عن NODE_ENV
# development | staging | production
# staging تعرض شريط تنبيه أعلى لوحة الأدمن، والزرع يرفض production
APP_ENV="development"

# أرقام تجربة لـstaging بلا كلفة رسائل — رمزها الثابت 000000
# وكل استخدام يُسجَّل في AuditLog بنوع otp.test_number.
# الأرقام الحقيقية تمرّ بالمزوّد دائمًا. اتركه فارغًا في الإنتاج.
OTP_TEST_NUMBERS=""

# ═══ حساب السوبر أدمن ═══
#
# يُطبَّق عند **كل إقلاع** لا عند الزرع وحده: فتغيير ADMIN_PASSWORD هنا
# ثم إعادة النشر يبدّل الكلمة فعلًا. ولا يُكتب شيء إن لم يتغيّر شيء.
#
# · بريدٌ جديد يُنشئ حسابًا جديدًا ولا يهدم القديم.
# · تبديل الكلمة لا يُبطل TOTP — تطبيق المصادقة يبقى كما هو.
# · وحسابٌ قائم بدورٍ أدنى يبقى بدوره: الترقية لا تكون أثرًا جانبيًّا.
#
# واتركهما فارغين إن لم ترد هذا الباب — الإقلاع يمضي.
ADMIN_EMAIL=
ADMIN_PASSWORD=""
# اختياري — الاسم المعروض في اللوحة (الافتراضيّ: البريد نفسه)
ADMIN_NAME=""
# اضبطه 1 مرّةً واحدة إن فقدتَ تطبيق المصادقة: يولّد سرًّا جديدًا
# ويطبعه في سجلّ الإقلاع. ثم **احذفه** — وإلّا تولّد سرٌّ كل نشرة.
ADMIN_RESET_TOTP=

# عنوان خدمة الوقت الحقيقي — فارغًا يعمل الموقع بالاستطلاع وحده
NEXT_PUBLIC_WS_URL=""

# ═══ الوظائف الزمنية ═══
# سرّ تشغيل /api/cron/run. **بلا ضبطه لا تعمل المهل إطلاقًا** (يردّ ٥٠٣):
# لا تنتهي العروض ولا تسقط الطلبات غير المدفوعة ولا تُغلق المزادات.
CRON_SECRET=
