// CarSell — مخطط المرحلة الأولى
//
// المصدر: BUILD-WEB-ADMIN.md القسم ٥، معدّلًا بما أقرّه docs/DESIGN-DECISIONS.md.
// كل انحراف عن القسم ٥ معلَّم بتعليق «قرار ن» يشير إلى بند القرار.
//
// قواعد ملزمة:
//   · كل مبلغ Decimal — ممنوع Float (القسم ٥).
//   · كل التواريخ UTC؛ العرض بتوقيت الرياض في الواجهة فقط.
//   · الحذف منطقي لما له أثر مالي، وفيزيائي للمسودّات فقط.
//   · reservePrice و minAcceptPrice لا يخرجان في أي استجابة عامة.
//   · كل إجراء أدمن يكتب AuditLog.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: رابط الاتصال في `prisma.config.ts` لأوامر الترحيل،
// و`PrismaClient` يستقبل مُهيّئ سائق (`@prisma/adapter-pg`) — انظر src/lib/db.ts
datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════
//  الهوية
// ═══════════════════════════════════════════════════════════

model User {
  id           String     @id @default(cuid())
  phone        String     @unique // E.164
  email        String?    @unique
  name         String?
  avatarUrl    String?
  locale       String     @default("ar")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  idVerified   Boolean    @default(false)
  idVerifiedAt DateTime?
  iban         String? // مشفّر
  /// موافقة التسويق — **تُطلب ولا تُفترض** (ضوابط A9).
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  dealerId     String?
  createdAt    DateTime   @default(now())

  dealer          Dealer?          @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  vehicles        Vehicle[]
  listings        Listing[]
  offers          Offer[]
  bids            Bid[]
  deposits        Deposit[]
  ordersAsBuyer   Order[]          @relation("OrderBuyer")
  ordersAsSeller  Order[]          @relation("OrderSeller")
  serviceRequests ServiceRequest[]
  subscriptions   Subscription[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  reports         Report[]
  invoices        Invoice[]
  overrides       EntitlementOverride[]
  notifications   Notification[]
  campaignSends   CampaignSend[]
  pushPreferences NotificationPreference[]
  deviceTokens    DeviceToken[]
  wallet          Wallet?

  @@index([status, createdAt])
  @@index([dealerId])
}

enum UserRole {
  USER
  DEALER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

/// فريق الأدمن منفصل عن مستخدمي السوق — لا مشاركة مصادقة ولا كوكي.
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  role             AdminRole
  lastSeenAt       DateTime?
  status           String    @default("active")

  // كلمة مرور + TOTP إلزامي لكل الأدوار بلا استثناء.
  // لا حقل `twoFactorEnabled`: الحقيقة هي `totpEnrolledAt !== null`،
  // وحقلٌ منفصل يوحي بالاختيارية وقد يُقرأ لاحقًا كبوابة.
  passwordHash       String
  totpSecret         String? // مشفّر
  totpEnrolledAt     DateTime?
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime  @default(now())
  mustChangePassword Boolean   @default(true)

  sessions      AdminSession[]
  financeInputs FinanceInput[]
}

/// جلسات الأدمن — تُبطَل بتغيير الكلمة أو الدور، ولا تُشارك جلسة المستخدم.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

enum AdminRole {
  SUPER_ADMIN
  OPS
  FINANCE
  SUPPORT
  CONTENT
  READONLY
}

/**
 * المعرض — **حقول الملف العام وحدها**.
 * Wg (صفحة المعرض التي يراها المشتري) مرحلة أولى.
 * لوحة تحكّم التاجر D1–D11 مرحلة ثالثة: لا فروع ولا أعضاء
 * ولا فواتير ولا استيراد جماعي هنا.
 */
model Dealer {
  /// ═══ هامش الربح صفةٌ على التاجر لا خيارٌ في الصفقة ═══
  /// يمنحها الأدمن بمستند من الهيئة، **ولا تُطبَّق تلقائيًّا أبدًا**.
  marginSchemeApproved Boolean   @default(false)
  marginSchemeRef      String?
  marginSchemeBy       String?
  marginSchemeAt       DateTime?

  id          String       @id @default(cuid())
  slug        String       @unique
  nameAr      String
  nameEn      String
  logoUrl     String?
  coverUrl    String?
  aboutAr     String?
  aboutEn     String?
  city        String
  address     String?
  phone       String?
  hours       Json?
  crNumber    String?
  vatNumber   String?
  verified    Boolean      @default(false) // شارة «تاجر موثّق» يمنحها الأدمن
  ratingAvg   Decimal?     @db.Decimal(3, 2)
  ratingCount Int          @default(0)
  status      DealerStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  members       User[]
  vehicles      Vehicle[]
  subscriptions Subscription[]

  @@index([status, city])
}

enum DealerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([phone, expiresAt])
}

// ═══════════════════════════════════════════════════════════
//  الكتالوج (A12–A14, A19)
// ═══════════════════════════════════════════════════════════

model Brand {
  id      String  @id @default(cuid())
  nameAr  String
  nameEn  String
  slug    String  @unique
  logoUrl String?
  visible Boolean @default(true)
  sort    Int     @default(0)

  models   Model[]
  vehicles Vehicle[]
}

model Model {
  id       String    @id @default(cuid())
  brandId  String
  nameAr   String
  nameEn   String
  yearFrom Int
  yearTo   Int?
  bodyType BodyType? // افتراضي للطراز
  visible  Boolean   @default(true)

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  trims      Trim[]
  vehicles   Vehicle[]
  priceStats PriceStat[]

  @@index([brandId, visible])
}

model Trim {
  id       String @id @default(cuid())
  modelId  String
  nameAr   String
  nameEn   String
  yearFrom Int
  yearTo   Int?

  // القيَم الموروثة — تُنسخ لقطةً إلى الإعلان وقت النشر
  bodyType     BodyType
  transmission Transmission
  fuel         FuelType
  drivetrain   Drivetrain
  seats        Int
  doors        Int
  engineL      Decimal?     @db.Decimal(3, 1)
  cylinders    Int?
  horsepower   Int?
  visible      Boolean      @default(true)

  model    Model         @relation(fields: [modelId], references: [id], onDelete: Restrict)
  // قرار ١٩: حلّ TrimFeature محلّ `defaultFeatures String[]` في القسم ٥
  features TrimFeature[]
  vehicles Vehicle[]
  // لا علاقة إلى PriceStat: `trimId` هناك قد يكون "*" لا معرّفًا

  @@index([modelId, visible])
}

enum BodyType {
  SEDAN
  SUV
  PICKUP
  HATCHBACK
  COUPE
  VAN
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
  DCT
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOUR_WD
}

/// قرار ١٩ — بنك المميّزات: لا اسم ميزة مكتوب في الكود
model Feature {
  key    String       @id // ثابت لا يُعدَّل بعد الإنشاء
  nameAr String // محتوى يُحرَّر ويظهر فورًا بلا نشر
  nameEn String
  group  FeatureGroup
  sort   Int          @default(0)
  /**
   * الإخفاء يزيلها من الفلتر وصفحة السيارة، ولا يحذفها من الفئات
   * ولا من الإعلانات المنشورة (قرار A19 بند ٤).
   */
  active Boolean      @default(true)
  /**
   * مواضع الظهور الأربعة المستقلة (قرار A19 بند ٣):
   * trim_editor | search_filter | listing_page | card_badge
   */
  placements String[]

  trims    TrimFeature[]
  listings ListingFeature[]

  @@index([group, sort])
}

enum FeatureGroup {
  SAFETY
  COMFORT
  TECH
}

model TrimFeature {
  trimId     String
  featureKey String
  isDefault  Boolean @default(false)

  trim    Trim    @relation(fields: [trimId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([trimId, featureKey])
}

// ═══════════════════════════════════════════════════════════
//  المركبة والإعلان
// ═══════════════════════════════════════════════════════════

model Vehicle {
  id       String  @id @default(cuid())
  ownerId  String
  dealerId String?
  vin      String? // فريد إن وُجد
  plateLetters String? // ٣ أحرف
  plateNumbers String? // ٤ أرقام

  // قرار ٣٢: المعرّف للإحصاء والفلترة، واللقطة النصّية للعرض
  brandId String
  modelId String
  trimId  String? // الإدخال اليدوي قد لا يعرف الفئة

  // لقطة الكتالوج وقت الإضافة — لا تُقرأ من Trim لاحقًا
  brandName     String
  modelName     String
  trimName      String?
  year          Int
  bodyType      BodyType
  transmission  Transmission
  fuel          FuelType
  drivetrain    Drivetrain
  seats         Int
  mileageKm     Int
  colorExterior String
  colorInterior String?
  paintStatus   PaintStatus      @default(UNKNOWN) // قرار ١٦ — يقرّه البائع، ويتجاوزه الفحص
  spec          VehicleSpec // سعودي/خليجي/وارد وكيل
  condition     VehicleCondition // جديد/مستعمل
  overriddenFields Json? // {field: {value, reason}}
  city          String
  entryMode     EntryMode // VIN_LOOKUP | MANUAL
  createdAt     DateTime         @default(now())

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  dealer             Dealer?             @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model              Model               @relation(fields: [modelId], references: [id], onDelete: Restrict)
  trim               Trim?               @relation(fields: [trimId], references: [id], onDelete: SetNull)
  listings           Listing[]
  history            VehicleHistoryItem[]
  inspectionReports  InspectionReport[]
  serviceRequests    ServiceRequest[]

  @@unique([vin])
  @@index([ownerId])
  @@index([brandId, modelId, year])
}

enum VehicleSpec {
  SAUDI
  GCC
  AGENT_IMPORT
}

enum VehicleCondition {
  NEW
  USED
}

enum EntryMode {
  VIN_LOOKUP
  MANUAL
}

/// قرار ١٦
enum PaintStatus {
  ORIGINAL
  PARTIAL
  REPAINTED
  UNKNOWN
}

/// قرار ١٥ — ما تملكه المنصة فقط. ما لا نملكه لا يُعرض.
/// البلاغات والملّاك السابقون والرهن حصريًا في تقرير موجز المدفوع.
model VehicleHistoryItem {
  id         String               @id @default(cuid())
  vehicleId  String
  type       String // owner | service | inspection
  titleAr    String
  detailAr   String?
  titleEn    String? // ← إضافة: الويب ثنائي اللغة (انظر التقرير)
  detailEn   String?
  source     VehicleHistorySource
  occurredAt DateTime

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, occurredAt])
}

enum VehicleHistorySource {
  SELLER
  INSPECTION
  PLATFORM
}

model Listing {
  id             String        @id @default(cuid())
  ref            String        @unique // ADS2026A0005
  vehicleId      String
  sellerId       String
  type           ListingType
  status         ListingStatus @default(DRAFT)
  askPrice       Decimal       @db.Decimal(12, 2)
  minAcceptPrice Decimal?      @db.Decimal(12, 2) // مخفي عن المشترين — لا يخرج في استجابة عامة
  negotiable     Boolean       @default(false)
  city           String
  viewCount      Int           @default(0)
  featuredUntil  DateTime?
  publishedAt    DateTime?
  closedAt       DateTime?
  closeReason    String?
  reviewReason   ReviewReason? // قرار ٣٣ — أي شرط أدخله المراجعة (لطابور A15)

  vehicle  Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  seller   User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  images   ListingImage[]
  features ListingFeature[]
  offers   Offer[]
  auction  Auction?
  orders   Order[]
  serviceRequests ServiceRequest[]

  @@index([status, type, city])
  @@index([status, publishedAt])
}

enum ListingType {
  DIRECT
  NEGOTIATION
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RESERVED
  SOLD
  SUSPENDED
  EXPIRED
}

/// قرار ٣٣ — الشروط الأربعة وحدها تُدخل الإعلان المراجعة.
/// لا نشر بمراجعة بشرية افتراضية.
enum ReviewReason {
  DUPLICATE_IMAGE /// تكرار صورة > ٩٠٪ مع إعلان مستخدم آخر
  PRICE_OUTLIER /// سعر أقل من ٤٠٪ من PriceStat.p25
  NEW_ACCOUNT_BURST /// حساب عمره < ٧ أيام وله أكثر من ٣ إعلانات
  USER_REPORT /// بلاغ وارد
}

model ListingImage {
  id            String   @id @default(cuid())
  listingId     String
  r2Key         String
  sort          Int
  isCover       Boolean  @default(false)
  phash         String?
  plateBlurred  Boolean  @default(false)
  qualityFlags  String[] // BLURRY LOW_RES DUPLICATE

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sort])
  @@index([phash])
}

/// قرار ١٩ — مميّزات الإعلان: لقطة وقت النشر، لا قراءة حيّة من الفئة
model ListingFeature {
  listingId  String
  featureKey String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Restrict)

  @@id([listingId, featureKey])
}

// ═══════════════════════════════════════════════════════════
//  التفاوض والمزاد
// ═══════════════════════════════════════════════════════════

model Offer {
  id            String      @id @default(cuid())
  listingId     String
  buyerId       String
  amount        Decimal     @db.Decimal(12, 2)
  status        OfferStatus @default(PENDING)
  parentOfferId String? // العرض المقابل
  autoRejected  Boolean     @default(false)
  expiresAt     DateTime // ٤٨ ساعة
  createdAt     DateTime    @default(now())

  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer       User    @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  parentOffer Offer?  @relation("OfferCounter", fields: [parentOfferId], references: [id], onDelete: SetNull)
  counters    Offer[] @relation("OfferCounter")

  @@index([listingId, status])
  @@index([buyerId, status])
  @@index([status, expiresAt])
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model Auction {
  id             String        @id @default(cuid())
  listingId      String        @unique
  startPrice     Decimal       @db.Decimal(12, 2)
  reservePrice   Decimal?      @db.Decimal(12, 2) // مخفي — لا يُعاد في API العام أبدًا
  bidIncrement   Decimal       @db.Decimal(12, 2)
  buyNowPrice    Decimal?      @db.Decimal(12, 2)
  depositAmount  Decimal       @db.Decimal(12, 2)
  startsAt       DateTime
  endsAt         DateTime
  extendedCount  Int           @default(0)
  status         AuctionStatus @default(SCHEDULED)
  viewingCity    String?
  viewingAddress String?
  /// مهلة البائع لقبول أعلى مزايدة بعد إغلاق باحتياطي غير مبلوغ (19e)
  sellerDecisionDueAt DateTime?

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bids     Bid[]
  deposits Deposit[]

  @@index([status, endsAt])
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED_MET
  ENDED_UNMET
  CANCELLED
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Decimal  @db.Decimal(12, 2)
  isAuto    Boolean  @default(false)
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  @@index([auctionId, amount])
}

model Deposit {
  id         String        @id @default(cuid())
  auctionId  String
  userId     String
  amount     Decimal       @db.Decimal(12, 2)
  status     DepositStatus @default(HELD)
  releasedAt DateTime?

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([auctionId, userId])
}

enum DepositStatus {
  HELD
  RELEASED
  FORFEITED
  APPLIED
}

// ═══════════════════════════════════════════════════════════
//  الطلب والضمان والفوترة
// ═══════════════════════════════════════════════════════════

model Order {
  id               String      @id @default(cuid())
  ref              String      @unique // ORD-2026-1184
  listingId        String
  buyerId          String
  sellerId         String
  source           OrderSource // DIRECT | OFFER | AUCTION | BUY_NOW
  stage            OrderStage  @default(REQUEST)
  status           OrderStatus @default(ACTIVE)
  agreedPrice      Decimal     @db.Decimal(12, 2)
  commissionPct    Decimal     @db.Decimal(5, 2) // لقطة وقت الإنشاء
  commissionAmount Decimal     @db.Decimal(12, 2)

  // قرار ١٧ — رسوم النقل لقطةً من PlatformSetting، والضريبة مضمَّنة ١٥/١١٥
  transferFee Decimal @default(0) @db.Decimal(12, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  /// تاريخ الإنشاء — **غير** `stageEnteredAt`: الثاني يتصفّر عند كل
  /// انتقال مرحلة، فلا يصلح لترتيب «طلباتي» ولا لأي قياس زمني.
  createdAt             DateTime  @default(now())
  stageEnteredAt        DateTime  @default(now()) // لحساب مدة البقاء
  /// موعد انتهاء مهلة الدفع. **حقل واحد للمهلة** — انظر التعليق أدناه.
  paymentDueAt          DateTime?
  /// المتبقّي من المهلة لحظة التجميد بالنزاع، لتُستأنف من حيث توقّفت
  paymentPausedRemainingMs Int?
  /// مبلغ التسوية الجزئية — البيع يكتمل بسعر أقلّ، والسعر الأصلي في
  /// `agreedPrice` يبقى. الفاتورة بالمُسوَّى، والتدقيق يحتاج الاثنين.
  settlementAmount      Decimal?  @db.Decimal(12, 2)
  transferAppointmentAt DateTime?
  /// ═══ القاعدة ١ ═══ سقف النقل: الدفع + ٧ أيام.
  /// لم يكتمل ⇒ استرجاع تلقائيّ للمشتري. وللأدمن تمديدٌ **واحد**.
  transferDeadlineAt      DateTime?
  transferDeadlineExtendedAt DateTime?
  transferExtensionReason    String?
  /// ═══ القاعدة ٢ ═══ نافذة الاسترجاع: تأكيد النقل + ٧ أيام.
  /// **لا إفراج للبائع قبل انقضائها** — وهي جزء من عمر الحجز لا ملحق به.
  returnWindowEndsAt      DateTime?
  cancelledBy           String?
  cancelReason          String?

  listing  Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer    User         @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller   User         @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  events   OrderEvent[]
  escrow   Escrow?
  payments Payment[]
  taxInvoices TaxInvoice[]
  settlement  SettlementStatement?
  agreement   VehicleSaleAgreement?
  disputes Dispute[]
  invoices Invoice[]

  @@index([stage, status])
  @@index([buyerId])
  @@index([sellerId])
}

enum OrderSource {
  DIRECT
  OFFER
  AUCTION
  BUY_NOW
}

enum OrderStage {
  REQUEST
  APPROVED
  INSPECTION
  PAYMENT
  TRANSFER
  DONE
}

enum OrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  STALLED
  DISPUTED
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  type      String
  fromStage OrderStage?
  toStage   OrderStage?
  actorId   String?
  actorType String // user | admin | system
  payload   Json?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// محفظة المستخدم — **دفتر قيود، والرصيد مشتقّ منه**.
///
/// رصيدٌ مخزَّن في عمود يفترق عن مجموع قيوده عند أوّل كتابة تفشل بعد
/// أخرى، ولا يظهر الفرق إلا عند مطالبة. القيود لا تُعدَّل ولا تُحذف —
/// التصحيح قيدٌ مضادّ يبقى أثره.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries WalletEntry[]
}

model WalletEntry {
  id        String   @id @default(cuid())
  walletId  String
  /// موجب إيداع وسالب سحب — والمجموع هو الرصيد
  amount    Decimal  @db.Decimal(12, 2)
  kind      String // settlement_refund | payout | topup | adjustment
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([orderId])
}

model Escrow {
  id                String       @id @default(cuid())
  orderId           String       @unique
  amount            Decimal      @db.Decimal(12, 2)
  status            EscrowStatus @default(PENDING)
  heldAt            DateTime?
  releasedAt        DateTime?
  // الموافقة الثنائية عبر ApprovalRequest بـ kind = ESCROW_RELEASE — آلية واحدة لكل الإجراءات الثنائية
  /// مرجع لدى البوابة — «بوابة» لا «مزوّد»، فالمفردة واحدة في المخطّط والنطاق
  gatewayRef        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  PARTIAL_REFUND
}

model Dispute {
  id         String        @id @default(cuid())
  orderId    String
  openedBy   String
  reason     String
  status     DisputeStatus @default(OPEN)
  /// مهلة الردّ — **من فتح النزاع لا من آخر رسالة**. صمت أحد الطرفين
  /// لا يمدّدها، وإلّا صار التجاهل استراتيجية.
  slaDueAt   DateTime
  resolution String? // FULL_REFUND | PARTIAL_SETTLEMENT | RELEASE_TO_SELLER
  /// مبلغ التسوية الجزئية — `null` لغيرها
  resolutionAmount Decimal? @db.Decimal(12, 2)
  resolvedBy String?
  resolvedAt DateTime?
  /// طلب الموافقة الذي نُفِّذ به القرار — لا قرار بلا موافقة عضوين
  approvalId String?
  openedAt   DateTime      @default(now())
  messages   Json[]

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, slaDueAt])
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

/// قرار ١٧ — الفوترة بالكيان والأرقام، بلا اعتماد ZATCA بعد.
/// الضريبة مضمَّنة دائمًا: vatAmount = total × 15/115.
model Invoice {
  id        String      @id @default(cuid())
  ref       String      @unique
  orderId   String?
  userId    String
  type      InvoiceType
  subtotal  Decimal     @db.Decimal(12, 2)
  vatAmount Decimal     @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  status    String      @default("issued")
  zatcaUuid String?
  pdfUrl    String?
  issuedAt  DateTime    @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt])
  @@index([type, issuedAt])
}

enum InvoiceType {
  SALE
  COMMISSION
  SERVICE
  SUBSCRIPTION
}

// ═══════════════════════════════════════════════════════════
//  الخدمات
// ═══════════════════════════════════════════════════════════

model Service {
  key         String          @unique // inspection | mojaz | shipping | viewing …
  id          String          @id @default(cuid())
  nameAr      String
  nameEn      String
  descAr      String
  descEn      String
  price       Decimal         @db.Decimal(10, 2)
  category    ServiceCategory
  providerId  String?
  isAutomated Boolean         @default(false)
  slaHours    Int?
  placements  String[] // home_services | listing_banner | guide …
  active      Boolean         @default(true)
  sort        Int             @default(0)

  provider ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  requests ServiceRequest[]
}

enum ServiceCategory {
  PRE_PURCHASE
  POST_PURCHASE
  SELLER
}

model ServiceRequest {
  id         String               @id @default(cuid())
  ref        String               @unique
  serviceId  String
  userId     String
  listingId  String?
  vehicleId  String?
  status     ServiceRequestStatus @default(NEW)
  providerId String?
  amount     Decimal              @db.Decimal(10, 2)
  dueAt      DateTime?
  resultUrl  String? // PDF في R2
  createdAt  DateTime             @default(now())

  service           Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  provider          ServiceProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing           Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  inspectionReport  InspectionReport?

  @@index([status, dueAt])
}

enum ServiceRequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  DONE
  FAILED
  REFUNDED
}

model InspectionReport {
  id               String   @id @default(cuid())
  /// رقم يُقتبَس ويُبحث به — `cuid` لا يُملى في مكالمة هاتف
  ref              String   @unique
  serviceRequestId String   @unique
  vehicleId        String
  score            Int // 0–100
  sections         Json // ٢١٠ نقطة
  paintMap         Json
  inspectorName    String
  inspectedAt      DateTime
  pdfUrl           String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId, inspectedAt])
}

// ═══════════════════════════════════════════════════════════
//  التمويل — قرار ١٤: عرض وحساب فقط، بلا طلب ولا تكامل
// ═══════════════════════════════════════════════════════════

model FinanceProvider {
  id             String  @id @default(cuid())
  nameAr         String
  nameEn         String
  logoUrl        String?
  downPaymentPct Decimal @db.Decimal(5, 2)
  months         Int
  profitRatePct  Decimal @db.Decimal(5, 2)
  active         Boolean @default(true)
  sort           Int     @default(0)
}

/// إعداد افتراضي واحد لحساب «أقساط من» على البطاقات.
/// `Listing.financingEligible` مشتقّ لا مخزَّن:
/// `type != AUCTION && askPrice >= minPrice`.
model FinanceSetting {
  id             String  @id @default("default")
  downPaymentPct Decimal @default(20) @db.Decimal(5, 2)
  months         Int     @default(60)
  profitRatePct  Decimal @db.Decimal(5, 2)
  minPrice       Decimal @db.Decimal(12, 2)
}

// ═══════════════════════════════════════════════════════════
//  الباقات والعمولة والرسوم
// ═══════════════════════════════════════════════════════════

model Plan {
  id           String  @id @default(cuid())
  key          String  @unique
  nameAr       String
  nameEn       String
  price        Decimal @default(0) @db.Decimal(10, 2)
  billingCycle String  @default("monthly")
  visible      Boolean @default(true)

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]
}

model Entitlement {
  key          String // can_auction | commission_pct …
  type         String // bool | int | percent
  defaultValue String
  description  String

  plans PlanEntitlement[]

  @@id([key])
}

model PlanEntitlement {
  planId         String
  entitlementKey String
  value          String

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement Entitlement @relation(fields: [entitlementKey], references: [key], onDelete: Cascade)

  @@id([planId, entitlementKey])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String?
  dealerId           String?
  planId             String
  startsAt           DateTime
  endsAt             DateTime?
  status             String    @default("active")
  grandfatheredUntil DateTime?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer Dealer? @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  plan   Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([dealerId, status])
}

model CommissionRule {
  id         String   @id @default(cuid())
  scope      String // global | plan | dealer | listing_type
  scopeId    String?
  pct        Decimal  @db.Decimal(5, 2)
  fixedFee   Decimal  @default(0) @db.Decimal(10, 2)
  minFee     Decimal? @db.Decimal(10, 2)
  maxFee     Decimal? @db.Decimal(10, 2)
  activeFrom DateTime

  @@index([scope, activeFrom])
}

/// قرار ١٧ — إعدادات المنصة: رسوم النقل ونسبة الضريبة.
/// صفّ واحد؛ القيَم تُنسخ لقطةً إلى الطلب وقت إنشائه.
model PlatformSetting {
  id          String  @id @default("default")
  transferFee Decimal @default(350) @db.Decimal(10, 2)
  vatPct      Decimal @default(15) @db.Decimal(5, 2)
}

/// قرار ٢٠ — مدخلات محاسبة الشركة اليدوية (تبويب داخل A3، صلاحية FINANCE).
/// CAC وLTV والمدرج تُحسب من هذه + بيانات المنصة، ولا تُدخَل مباشرة.
model FinanceInput {
  id        String   @id @default(cuid())
  month     String // YYYY-MM
  key       String // salaries | marketing_spend | infra_cost | referral_incentives | content_seo
  value     Decimal  @db.Decimal(12, 2)
  note      String?
  enteredBy String
  updatedAt DateTime @updatedAt

  admin AdminUser @relation(fields: [enteredBy], references: [id], onDelete: Restrict)

  @@unique([month, key])
}

// ═══════════════════════════════════════════════════════════
//  اهتمام المستخدم — قرار ١٨
// ═══════════════════════════════════════════════════════════

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
}

model SavedSearch {
  id         String   @id @default(cuid())
  userId     String
  name       String?
  filters    Json
  notify     Boolean  @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════
//  المحتوى والتشغيل
// ═══════════════════════════════════════════════════════════

model FaqItem {
  id         String  @id @default(cuid())
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String
  category   String
  sort       Int     @default(0)
  active     Boolean @default(true)

  placements FaqPlacement[]
}

model FaqPlacement {
  id          String       @id @default(cuid())
  faqId       String
  surface     String // listing_page | help_center | checkout
  listingType ListingType?
  condition   Json?
  sort        Int          @default(0)
  active      Boolean      @default(true)

  faq FaqItem @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@index([surface, listingType, active])
}

/// قرار ٢٦ — ستة قوالب لا آلاف النصوص. تُخفى الفقرة إن كانت العيّنة < ٨.
/// جدول **عرض** لأنواع الهياكل — لا كيانات.
/// المفتاح هو `BodyType` نفسه، فلا مرجع جديد ولا مفتاح خارجي ثانٍ
/// يمكن أن ينحرف عن التعداد. الاسم والصورة والترتيب محتوى يحرّره
/// الأدمن في A12 كما يحرّر الماركات.
model BodyTypeDisplay {
  key      BodyType @id
  nameAr   String
  nameEn   String
  imageUrl String? // صورة ظلّية يرفعها الأدمن
  sort     Int      @default(0)
  visible  Boolean  @default(true)

  @@index([visible, sort])
}

/// المستندات القانونية — الشروط والخصوصية والاسترجاع.
///
/// **نسخة وتاريخ سريان لكل مستند**: مستخدم قَبِل شروطًا في مارس محكومٌ
/// بنصّها لا بنصّ اليوم، فلا يجوز أن يُستبدل النصّ في مكانه بلا أثر.
/// والبنود `Json` لأنها تختلف عددًا وعمقًا بين مستند وآخر.
model LegalDocument {
  key         String   @id // terms | privacy | refund | cookies
  titleAr     String
  titleEn     String
  version     String // 1.0 · 1.1
  effectiveAt DateTime
  summaryAr   String?
  summaryEn   String?
  sections    Json // [{ n, titleAr, titleEn, bodyAr, bodyEn }]
  active      Boolean  @default(true)
  sort        Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([active, sort])
}

model SeoTemplate {
  key       String   @id
  surface   String // search | landing_city | landing_brand | landing_model …
  titleAr   String
  titleEn   String
  introAr   String
  introEn   String
  outroAr   String
  outroEn   String
  variables String[]
  active    Boolean  @default(true)
}

/// الإشعار المُرسَل — القالب يصف الشكل، وهذا يسجّل الواقعة.
///
/// القاعدتان ١ و٥ في القسم ٧ تشترطان إشعارًا («يُرفض تلقائيًا **مع
/// إشعار**»، «إعادة نشر + **إخطار المتقدّمين**»)، وقالبٌ بلا سجلّ
/// يجعل الشرط غير قابل للاختبار: لا أثر يُقاس.
///
/// `critical` لا يُوقَف (قاعدة ١٧) — ولذلك الأولوية على الإشعار نفسه
/// لا على تفضيل المستخدم وحده.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  templateKey String
  priority   String    @default("normal") // critical | high | normal
  /// متغيّرات القالب وقت الإرسال — لقطة، فتغييرُ القالب لا يغيّر ما أُرسل
  payload    Json?
  entityType String? // Offer | Order | Listing
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([entityType, entityId])
}

model NotificationTemplate {
  key           String   @id
  channelEmail  Boolean  @default(false)
  channelSms    Boolean  @default(false)
  channelPush   Boolean  @default(false)
  channelInApp  Boolean  @default(true)
  priority      String   @default("normal") // critical | high | normal
  subjectAr     String?
  subjectEn     String?
  bodyAr        String?
  bodyEn        String?
  smsAr         String?
  smsEn         String?
  variables     String[]
  active        Boolean  @default(true)
}

model AdSlot {
  key           String  @id // home_story | home_banner | search_inline …
  nameAr        String
  width         Int
  height        Int
  pricingModel  String // day | week | cpm | cpc
  basePrice     Decimal @db.Decimal(10, 2)
  maxPerSession Int     @default(1)
  active        Boolean @default(true)

  campaigns AdCampaign[]
}

model AdCampaign {
  id             String   @id @default(cuid())
  advertiserName String
  slotKey        String
  creativeUrl    String
  targetUrl      String
  startsAt       DateTime
  endsAt         DateTime
  budget         Decimal  @db.Decimal(10, 2)
  targeting      Json? // city | brand | userType
  priority       Int      @default(0)
  status         String   @default("scheduled")
  impressions    Int      @default(0)
  clicks         Int      @default(0)

  slot AdSlot @relation(fields: [slotKey], references: [key], onDelete: Restrict)

  @@index([status, startsAt, endsAt])
}

/// بلاغات المستخدمين
model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String // listing | user
  targetId    String
  reason      String
  details     String?
  attachments String[]
  status      String   @default("open")
  resolvedBy  String?
  createdAt   DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ═══════════════════════════════════════════════════════════
//  المزوّدون والتجاوزات والتكاملات والموافقات
// ═══════════════════════════════════════════════════════════

/// مزوّد خدمة أو تمويل — يُسنِد إليه الأدمن طلبات الخدمات (A6)
model ServiceProvider {
  id            String       @id @default(cuid())
  nameAr        String
  nameEn        String
  logoUrl       String?
  type          ProviderType
  contactPhone  String?
  contactEmail  String?
  commissionPct Decimal?     @db.Decimal(5, 2)
  slaHours      Int?
  cities        String[]
  active        Boolean      @default(true)

  services Service[]
  requests ServiceRequest[]

  @@index([type, active])
}

enum ProviderType {
  INSPECTION
  SHIPPING
  INSURANCE
  DETAILING
  PHOTOGRAPHY
  FINANCE
  OTHER
}

/**
 * الحلقة الوسطى في قراءة الخصائص: الباقة ← **التجاوز** ← قواعد العمولة.
 * الكود يسأل `entitlement("can_auction")` ولا يسأل عن الباقة ولا عن الدور.
 */
model EntitlementOverride {
  id             String    @id @default(cuid())
  userId         String?
  dealerId       String?
  entitlementKey String
  value          String
  reason         String
  expiresAt      DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entitlementKey])
  @@index([dealerId, entitlementKey])
}

/// A11 — كل مزوّد خارجي. المفاتيح مشفّرة ولا تُعرض كاملة،
/// والتدوير يمرّ بـApprovalRequest بـ kind = KEY_ROTATION.
model Integration {
  key             String              @id // otp_sms | nafath | moyasar | r2 …
  nameAr          String
  provider        String
  category        IntegrationCategory
  status          IntegrationStatus   @default(INACTIVE)
  configPublic    Json?
  /// ═══ قرار ٣٣ ═══ البيئة الفعّالة. وstaging مقيَّد بـTEST في الكود
  /// لا بالانضباط — `effectiveEnvironment()` تتجاهل هذا الحقل خارج الإنتاج.
  activeEnv       IntegrationEnv      @default(TEST)
  lastCheckAt     DateTime?
  lastCheckOk     Boolean?
  failureBehavior String

  credentials IntegrationCredential[]

  @@index([category, status])
}

enum IntegrationEnv {
  TEST
  LIVE
}

/// مفاتيح تكامل في بيئة واحدة.
///
/// جدولٌ مستقلّ لا عمودان: التلميحات والتدوير وتاريخ آخر تغيير كلّها
/// **لكل بيئة**، وعمودان يجعلانها تتشارك صفًّا واحدًا فتختلط.
model IntegrationCredential {
  integrationKey   String
  env              IntegrationEnv
  secretsEncrypted String?
  /// تلميحات معروضة — مخزَّنة نصًّا وقت الكتابة، فالعرض لا يفكّ تشفيرًا
  hints            Json?
  updatedAt        DateTime       @updatedAt

  integration Integration @relation(fields: [integrationKey], references: [key], onDelete: Cascade)

  @@id([integrationKey, env])
}

enum IntegrationCategory {
  IDENTITY
  PAYMENT
  GOVERNMENT
  INFRASTRUCTURE
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  DEGRADED
}

/**
 * آلية «بعضوين» الواحدة لكل الإجراءات الثنائية.
 * حلّت محلّ `Escrow.releaseApprovedBy`: دور واحد لا يكفي ولو كان الأعلى.
 * التنفيذ يقع متى بلغ `approvedBy` عدد `requiredApprovals`.
 */
model ApprovalRequest {
  id                String         @id @default(cuid())
  kind              ApprovalKind
  entityType        String
  entityId          String
  payload           Json
  requestedBy       String
  approvedBy        String[]
  requiredApprovals Int            @default(2)
  status            ApprovalStatus @default(PENDING)
  expiresAt         DateTime
  executedAt        DateTime?

  @@index([status, kind])
  @@index([entityType, entityId])
}

enum ApprovalKind {
  ESCROW_RELEASE
  DISPUTE_RESOLUTION
  KEY_ROTATION
  /// قرار ٣٣ — تبديل بيئة تكامل بين الاختبار والإنتاج
  INTEGRATION_ENV
  /// قرار ٣٤ — تبديل بوابة غرض دفع
  PAYMENT_ROUTE
  COMMISSION_CHANGE
  PLAN_CHANGE
  USER_BAN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorType String // admin | user | system
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

/// يُعاد بناؤه ليليًا.
/// قرار ٣٠ — RangeBar: طرفا المحور المئين ١٠ و٩٠، والشريط الأخضر ٢٥–٧٥.
model PriceStat {
  id      String @id @default(cuid())
  modelId String
  year    Int

  /**
   * "*" لا NULL — لأن Postgres يعدّ كل NULL مميّزًا عن غيره،
   * فلا ينعقد `@@unique` على الصفوف العامة (كل الفئات / كل المدن).
   * ولهذا لا علاقة `@relation` على `trimId`: القيمة قد تكون رمزًا لا معرّفًا.
   */
  trimId String @default("*")
  city   String @default("*")

  mileageBucket    Int // بآلاف الكيلومترات
  p10              Decimal  @db.Decimal(12, 2)
  p25              Decimal  @db.Decimal(12, 2)
  p50              Decimal  @db.Decimal(12, 2)
  p75              Decimal  @db.Decimal(12, 2)
  p90              Decimal  @db.Decimal(12, 2)
  sampleSize       Int
  daysToSellMedian Int?
  computedAt       DateTime

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, year, trimId, mileageBucket, city])
}

// ═══════════════════════════════════════════════════════════
//  التسويق وإشعارات الدفع — A9 وA10 (المهمة ٢٦)
//  هياكل تُفعَّل مع التطبيق: التخزين والقواعد هنا، والإرسال مؤجَّل.
// ═══════════════════════════════════════════════════════════

/// شريحة جمهور — **قواعد لا أعضاء**.
///
/// حفظ قائمة المطابقين يجعلها تكذب بعد ساعة: من ألغى موافقته التسويقية
/// أو أتمّ صفقة يبقى في القائمة ويصله ما لا يخصّه. القواعد تُحوسَب وقت
/// الإرسال (معيار A9).
model Segment {
  id        String   @id @default(cuid())
  key       String   @unique
  nameAr    String
  /// شروط مركَّبة: [{ field, op, value }] — تُقرأ في resolveSegment
  rules     Json
  createdBy String
  createdAt DateTime @default(now())

  campaigns Campaign[]
}

model Campaign {
  id        String         @id @default(cuid())
  nameAr    String
  channels  String[] // email | sms | push
  segmentId String
  subjectAr String?
  bodyAr    String?
  status    CampaignStatus @default(DRAFT)
  /// الجدولة، و«أفضل وقت لكل مستخدم» تُحسب عند الإرسال لا تُخزَّن
  scheduledAt DateTime?
  sentAt      DateTime?
  createdBy   String
  createdAt   DateTime     @default(now())

  segment Segment        @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  sends   CampaignSend[]

  @@index([status, scheduledAt])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  SENT
  CANCELLED
}

/// أثر الحملة على مستخدم بعينه — **الأساس الذي تُحسب منه كل نسبة**.
/// ولا أعمدة «فُتح ٣٨٪» في الحملة: النسبة تُحسب من هذه الصفوف.
model CampaignSend {
  id         String    @id @default(cuid())
  campaignId String
  userId     String
  channel    String
  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  clickedAt  DateTime?
  convertedAt DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, channel])
  @@index([userId, sentAt])
}

/// قناة إشعار يراها المستخدم في إعداداته — A10.
model PushChannel {
  key    String  @id // auction_mine | orders_payment | offers_mine …
  nameAr String
  /// ═══ معيار A10 ═══ الحرِجة لا يقدر المستخدم إيقافها.
  userControllable Boolean @default(true)
  /// افتراضٌ مغلق للتسويقي — الموافقة تُطلب لا تُفترض.
  defaultOn        Boolean @default(true)
  sort             Int     @default(0)

  preferences NotificationPreference[]
}

model NotificationPreference {
  userId     String
  channelKey String
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel PushChannel @relation(fields: [channelKey], references: [key], onDelete: Cascade)

  @@id([userId, channelKey])
}

/// رمز جهاز — يُحذف عند أوّل رفض من المزوّد (قاعدة A10).
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // ios | android
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
//  الدفع الحقيقي و3DS — المهمة ٢٧
// ═══════════════════════════════════════════════════════════

/// بوابة دفع مربوطة — A20.
///
/// **القدرات معلَنة لا مفترضة**: النطاق يقرأها ويتصرّف، ولا يفترض أن
/// الحجز يدوم إلى الأبد. وبوابةٌ تنقصها قدرةٌ يحتاجها الغرض **لا تظهر
/// في قائمة الاختيار أصلًا** — لا تُعرض ثم تُرفض.
model PaymentGateway {
  key      String  @id // moyasar | tap | bank_escrow
  nameAr   String
  nameEn   String
  /// GatewayCapabilities — supportsHold · maxHoldDays · feePct …
  capabilities Json
  status   IntegrationStatus @default(INACTIVE)
  sort     Int     @default(0)

  routes  PaymentRoute[]
  changes PaymentRouteChange[] @relation("ToGateway")
  from    PaymentRouteChange[] @relation("FromGateway")
}

enum PaymentPurpose {
  VEHICLE_ESCROW
  AUCTION_DEPOSIT
  WALLET_TOPUP
  SERVICE_PURCHASE
  TRANSFER_FEE
  /// معطّل — كل الباقات مجانية الآن
  SUBSCRIPTION
}

/// توجيه غرضٍ إلى بوابة — **صفٌّ واحد لكل غرض: الحال الجارية**.
///
/// والتاريخ في `PaymentRouteChange` لا هنا: الحال تُقرأ بصفّ واحد بلا
/// ترتيب ولا نافذة زمنية.
model PaymentRoute {
  purpose     PaymentPurpose @id
  gatewayKey  String
  environment IntegrationEnv @default(TEST)
  /// تعطيلٌ يمنع الجديد ولا يمسّ القائم (قاعدة ٣ من قرار ٣٤)
  enabled     Boolean        @default(true)
  updatedBy   String
  updatedAt   DateTime       @updatedAt

  gateway PaymentGateway @relation(fields: [gatewayKey], references: [key], onDelete: Restrict)
}

/// سجلّ التبديلات — **للتفسير والتدقيق لا للحساب** (قرار ٣٦).
///
/// المطابقة لا تقرأ منه شيئًا: كل `Payment` يحمل `gatewayKey` لقطةً،
/// فالمطابقة تجمع به مباشرةً. ولو استنتجت البوابة من التوجيه لاستنتجت
/// ما تملكه — ويوم التبديل نفسه تكون البوابتان مسؤولتين معًا فلا يصفه
/// توجيهٌ واحد أصلًا.
model PaymentRouteChange {
  id              String         @id @default(cuid())
  purpose         PaymentPurpose
  fromGatewayKey  String?
  toGatewayKey    String
  fromEnvironment IntegrationEnv?
  toEnvironment   IntegrationEnv
  /// **إلزاميّ**: بعد سنة لا يتذكّر أحد لماذا، والقرار بلا سببه يُعاد نقضه
  reason          String
  at              DateTime       @default(now())
  approvalId      String?
  requestedBy     String
  approvedBy      String[]

  toGateway   PaymentGateway  @relation("ToGateway", fields: [toGatewayKey], references: [key], onDelete: Restrict)
  fromGateway PaymentGateway? @relation("FromGateway", fields: [fromGatewayKey], references: [key], onDelete: Restrict)

  @@index([purpose, at])
}

/// محاولة دفع — **سجلٌّ لكل محاولة لا لكل نجاح**.
///
/// المحاولات الفاشلة هي ما يُشتكى منه: «دفعتُ ولم يصل». وبلا صفّ لكل
/// محاولة لا يمكن الردّ إلا بـ«لا نرى شيئًا».
///
/// و`gatewayKey` **لقطة لا إعداد** (قاعدة ١ من قرار ٣٤): الحجز يُفرَج
/// من حيث أُنشئ، ولا نقل أرصدة بين بوابتين أبدًا.
model Payment {
  id         String         @id @default(cuid())
  orderId    String?
  purpose    PaymentPurpose
  gatewayKey String
  environment IntegrationEnv @default(TEST)
  amount     Decimal        @db.Decimal(12, 2)
  currency   String         @default("SAR")
  method     String // mada | visa | mastercard | applepay | bank_transfer
  status     PaymentStatus  @default(CREATED)
  /// مرجع الحجز لدى البوابة — تُبنى عليه التسوية والإلغاء
  holdRef     String?
  /// مرجع التسوية — يُبنى عليه الردّ الجزئي
  settleRef   String?
  /// رابط تحدّي 3DS حين تطلبه البطاقة
  actionUrl   String?
  failureCode String?
  /// ما سُوِّي وما رُدّ — جزئيًّا مسموح، فالمبلغ لا يكفي وحده
  settledAmount  Decimal? @db.Decimal(12, 2)
  returnedAmount Decimal? @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  heldAt      DateTime?
  settledAt   DateTime?
  cancelledAt DateTime?
  failedAt    DateTime?

  order  Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  /// المطابCة تجمع بالبوابة واليوم — لا تفترض بوابة واحدة لليوم
  @@index([gatewayKey, createdAt])
}

/// حالات المال — **بلغة الضمان لا بلغة البطاقة** (قرار ٣٤).
enum PaymentStatus {
  CREATED
  /// تحدّي 3DS — ينتظر المستخدم
  REQUIRES_ACTION
  /// طُلب من البوابة ولم تؤكّد بعد — حساب الأمانة يبقى هنا حتى الويبهوك
  PENDING
  /// الحجز مؤكَّد — المال محجوز ولم يدخل حسابنا
  HELD
  SETTLED
  PARTIALLY_SETTLED
  /// أُلغي الحجز — لا استرجاع، لأن المال لم يتحرّك
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
  FAILED
}

/// كل انتقال حالة — **بمصدره**: من المستخدم أم من ويب هوك البوابة.
model PaymentEvent {
  id         String         @id @default(cuid())
  paymentId  String
  type       String
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  source     String // user | gateway | admin | system
  detail     Json?
  createdAt  DateTime       @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

/// مفتاح التكرار — القسم ٦: كل `POST` يقبله، وهو إلزامي للدفع.
///
/// الشبكة تُعيد الطلب بلا أن يعرف المستخدم. وبلا هذا الجدول تُخصم
/// البطاقة مرّتين لأن المتصفّح أعاد الإرسال.
model IdempotencyKey {
  key       String   @id
  scope     String // payment.create | offer.create …
  /// بصمة الجسم: نفس المفتاح بجسم مختلف خطأٌ لا إعادة
  bodyHash  String
  /// الاستجابة الأولى — تُعاد حرفيًّا للطلب المكرّر
  response  Json
  status    Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// ويب هوك وصل — **يُخزَّن معرّفه قبل معالجته**.
/// المزوّد يعيد الإرسال عند أيّ شكّ، والمعالجة مرّتين تُفرج عن المال مرّتين.
model WebhookEvent {
  id          String   @id
  provider    String
  type        String
  signatureOk Boolean
  processedAt DateTime?
  receivedAt  DateTime @default(now())
  payload     Json

  @@index([provider, receivedAt])
}

// ═══════════════════════════════════════════════════════════
//  محرّك الضريبة والفوترة — A21 (المهمة ٣٥)
//
//  محرّكٌ لا فرعٌ في الكود: تعديل ضريبة القيمة المضافة قد يجعل المنصّة
//  «موِردًا مفترضًا» فتُستحقّ الضريبة على كامل قيمة المركبة لا على
//  العمولة — الفرق بين ١٥٠ و١٥٬٠٠٠ في صفقة واحدة. والتصنيف ينتظر
//  مذكرة، فالمعالجة صفوفٌ يديرها الأدمن لا شروطٌ في الكود.
// ═══════════════════════════════════════════════════════════

enum SellerType {
  INDIVIDUAL
  DEALER_VAT
  DEALER_NO_VAT
  COMPANY
}

enum BuyerType {
  INDIVIDUAL
  DEALER
  COMPANY
}

enum SupplyType {
  VEHICLE
  COMMISSION
  SERVICE
}

enum TaxableBase {
  FULL_VALUE
  MARGIN
  FEE_ONLY
  OUT_OF_SCOPE
}

enum InvoiceIssuer {
  PLATFORM
  SELLER
  PLATFORM_ON_BEHALF
}

/// قاعدة ضريبية — **المطابقة بالأدقّ نطاقًا**، وصفٌّ عامّ احتياطي.
///
/// و`activeTo` يجعل القاعدة تاريخيّة لا محذوفة: فاتورةٌ صدرت بقاعدة
/// انتهت تبقى مفهومة.
model TaxRule {
  id                 String        @id @default(cuid())
  sellerType         SellerType?
  buyerType          BuyerType?
  supplyType         SupplyType
  taxableBase        TaxableBase
  ratePct            Decimal?      @db.Decimal(5, 2)
  supplierIsPlatform Boolean       @default(false)
  invoiceIssuer      InvoiceIssuer
  activeFrom         DateTime
  activeTo           DateTime?
  /// `false` للقواعد التي تنتظر المذكرة الضريبية — تُعرض ولا تُطبَّق
  active             Boolean       @default(true)
  note               String?
  updatedBy          String
  updatedAt          DateTime      @updatedAt

  invoices TaxInvoice[]

  @@index([supplyType, active, activeFrom])
}

enum InvoiceStatus {
  ISSUED
  REPORTED
  REPORT_FAILED
  CANCELLED
}

/// فاتورة ضريبية — **وثيقة لا سجلّ**.
///
/// ولهذا **القاعدة تُنسَخ لقطةً كاملة**: تعديلها لاحقًا لا يغيّر فاتورة
/// صدرت. والوثيقة لا تتغيّر بأثر رجعي — أهمّ قاعدة في هذا القسم.
///
/// والتسلسل **متّصل بلا فجوات**: لا حذف فاتورة أبدًا، والإلغاء بإشعار
/// دائن يشير إلى الأصل.
model TaxInvoice {
  id       String @id @default(cuid())
  /// تسلسلي متّصل — فريدٌ ولا يُعاد استعماله
  sequence Int    @unique
  number   String @unique
  uuid     String @unique

  orderId String?
  /// لقطة القاعدة: معرّفها وكل قيَمها وقت الإصدار
  ruleId             String
  ruleSellerType     SellerType?
  ruleBuyerType      BuyerType?
  ruleSupplyType     SupplyType
  ruleTaxableBase    TaxableBase
  ruleRatePct        Decimal?      @db.Decimal(5, 2)
  ruleInvoiceIssuer  InvoiceIssuer

  supplierName    String
  supplierVatNo   String?
  supplierAddress String?
  customerName    String
  customerVatNo   String?

  issuedAt   DateTime
  suppliedAt DateTime

  subtotal Decimal @db.Decimal(12, 2)
  taxTotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  /// QR بترميز TLV ثم Base64 — حقول «فاتورة» الخمسة
  qrTlv        String?
  invoiceHash  String?
  signature    String?
  status       InvoiceStatus @default(ISSUED)
  reportedAt   DateTime?
  reportError  String?

  rule        TaxRule           @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines       TaxInvoiceLine[]
  creditNotes CreditNote[]

  @@index([orderId])
  @@index([status, issuedAt])
}

model TaxInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// إشعار دائن — **الإلغاء الوحيد الممكن**، ويشير إلى الأصل.
model CreditNote {
  id        String   @id @default(cuid())
  sequence  Int      @unique
  number    String   @unique
  uuid      String   @unique
  invoiceId String
  reason    String
  amount    Decimal  @db.Decimal(12, 2)
  taxAmount Decimal  @db.Decimal(12, 2)
  issuedAt  DateTime
  issuedBy  String

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

/// كشف تسوية مالية — **ليس فاتورة ضريبية**، ومكتوبٌ في رأسه.
model SettlementStatement {
  id            String   @id @default(cuid())
  orderId       String   @unique
  vehicleValue  Decimal  @db.Decimal(12, 2)
  commission    Decimal  @db.Decimal(12, 2)
  commissionTax Decimal  @db.Decimal(12, 2)
  gatewayFee    Decimal  @db.Decimal(12, 2)
  servicesTotal Decimal  @db.Decimal(12, 2)
  netToSeller   Decimal  @db.Decimal(12, 2)
  heldAmount    Decimal  @db.Decimal(12, 2)
  returnedAmount Decimal @db.Decimal(12, 2)
  issuedAt      DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

/// عقد بيع المركبة — **بين البائع والمشتري، ولسنا طرفًا فيه**.
model VehicleSaleAgreement {
  id           String   @id @default(cuid())
  orderId      String   @unique
  vin          String
  sellerName   String
  sellerIdNo   String?
  buyerName    String
  buyerIdNo    String?
  price        Decimal  @db.Decimal(12, 2)
  inspectionRef String?
  deliveryTerms String?
  issuedAt     DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}
